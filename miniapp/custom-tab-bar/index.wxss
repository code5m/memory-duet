.nav{display:flex;position:fixed;z-index:100;bottom:0;left:0;right:0;padding:13rpx 10rpx calc(11rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #ece8f1}.item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;min-width:0;min-height:83rpx;color:#8b849a}.icon{font-size:39rpx;line-height:1}.label{font-size:20rpx;font-weight:700}.item.active{color:#6754dc}.sea .item.active{color:#287c70}