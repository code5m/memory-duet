<view class="container"><view class="label">CHOOSE YOUR VIEW</view><view class="title">自由切换分类维度</view><view class="sub">按学科、难度、方法、目标等维度重新筛选</view><view class="card"><view class="sub">分类维度</view><picker range="{{dimensions}}" range-key="label" value="{{index}}" bindchange="dimensionChange"><view class="control">{{dimensions[index].label}} ▾</view></picker><view class="sub">分类取值</view><picker range="{{values}}" value="{{valueIndex}}" bindchange="valueChange"><view class="control">{{values[valueIndex]}} ▾</view></picker></view><view class="sub">找到 {{lessons.length}} 张卡片</view><view wx:for="{{lessons}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="title">{{item.icon}} {{item.title}}</view><view class="sub">{{item.topic}} · {{item.method}} · {{item.minutes}} 分钟</view></view></view>