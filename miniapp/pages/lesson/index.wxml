<view wx:if="{{lesson}}" class="container"><scene-switch wx:if="{{phase!=='quiz'}}"/><view class="label">{{lesson.subject}} · {{lesson.method}}</view><view class="title">{{lesson.title}}</view><view wx:if="{{phase==='study'}}" class="card"><view class="title">先理解，再记忆</view><view class="hint">{{lesson.cue}}</view><button class="button" bindtap="begin">遮住线索，独立回忆 ↗</button></view><view wx:elif="{{phase==='quiz'}}" class="card"><view class="title">{{lesson.question}}</view><input class="control" value="{{answer}}" bindinput="input" placeholder="输入你的答案"/><view wx:if="{{hintUsed}}" class="hint">{{lesson.cue}}</view><button wx:if="{{!hintUsed}}" bindtap="hint">查看提示</button><button class="button" bindtap="submit">核对答案</button></view><view wx:else class="card"><view class="title">{{result}}</view><view class="hint">参考答案：{{lesson.answer}}</view><view class="sub">{{lesson.explanation}}</view><button class="button" bindtap="retry">再学一次</button></view><view wx:if="{{phase!=='quiz'}}" class="card"><view class="card-title">还是太难记？</view><view class="sub">只生成求助草稿，不会自动公开答案、笔记或记录。</view><button bindtap="ask">发太难记漂流瓶 ↗</button></view></view>